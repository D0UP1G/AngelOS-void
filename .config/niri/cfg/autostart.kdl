// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-at-startup "angelos" "start"
    spawn-sh-at-startup "command -v systemctl >/dev/null 2>&1 && systemctl --user start voxtype-indicator.service || true"
